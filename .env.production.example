# Copiá este archivo a .env.production y reemplazá todos los valores CHANGE_ME.
APP_NAME="Black Multimarca"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME
TRUSTED_PROXIES=*
APP_TIMEZONE=America/Asuncion
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=CHANGE_ME
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
RECEIPT_MAX_KILOBYTES=5120
RECEIPT_ORPHAN_RETENTION_HOURS=48

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"
